{
  "name": "@inpulse/utils",
  "version": "4.0.1",
  "description": "Inpulse Utilities.",
  "repository": "git@github.com:inpulse-cx/utils.git",
  "author": "Jo Santana <josantana@gmail.com>",
  "license": "MIT",
  "private": false,
  "source": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./server": {
      "require": "./dist/cjs/server.js",
      "import": "./dist/esm/server.js",
      "types": "./dist/esm/server.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/esm/server.d.ts"
      ]
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "rm -rf ./dist && pnpm build:cjs && pnpm build:esm",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir dist/cjs --target es5",
    "build:esm": "tsc -p tsconfig.build.json --module esNext --outDir dist/esm --target es6",
    "prepublishOnly": "pnpm build",
    "release": "npm publish"
  },
  "devDependencies": {
    "@types/react": "^18.2.78 || ^19.0",
    "@types/react-dom": "^18.2.19 || ^19.0",
    "typescript": "^5.0"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "date-fns": "^4.1",
    "react": "^18.2 || ^19.0",
    "react-dom": "^18.2 || ^19.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "swr": "^2.2",
    "usehooks-ts": "^3.1"
  }
}